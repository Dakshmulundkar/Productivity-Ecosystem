rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the document belongs to the requesting user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: only owners can read/write their profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Tasks sub-collection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
      
      // Habits sub-collection
      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }
      
      // Habit Logs sub-collection
      match /habitLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
      
      // Profile sub-collection
      match /profile/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
