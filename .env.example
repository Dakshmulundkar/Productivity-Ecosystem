# ─── Server (never expose these to the client) ────────────────────────────────
DATABASE_URL=mysql://user:password@host:4000/dbname
JWT_SECRET=your_jwt_secret_here
OWNER_OPEN_ID=your_user_id
OWNER_NAME=YourName

# LLM / Storage API (optional — only needed if using AI features or file storage)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── App (EXPO_PUBLIC_ prefix = safe to bundle in app) ────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Firebase Auth (add when setting up Google Sign-In)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client IDs (from Firebase Console → Authentication → Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
